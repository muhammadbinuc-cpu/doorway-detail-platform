# 🔒 Environment Variables Template
# Copy this to .env.local and fill in your values
# NEVER commit .env.local to version control

# ============================================
# 🔒 REQUIRED - App will fail to start without these
# ============================================

# Firebase Admin SDK (get from Firebase Console > Project Settings > Service Accounts)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour private key here... \n-----END PRIVATE KEY-----\n"

# Stripe (get from Stripe Dashboard > Developers > API Keys)
# ⚠️ MUST start with 'sk_test_' (test mode) or 'sk_live_' (production)
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Webhook secret (Stripe Dashboard > Developers > Webhooks > Select webhook > Signing secret)
# ⚠️ MUST start with 'whsec_'
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# App URL (used for Stripe redirects, email links, etc.)
# Local development: http://localhost:3000
# Production: https://your-domain.com
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ============================================
# 🔒 OPTIONAL - Features will be disabled if not set
# ============================================

# Resend (email service) - get from https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Twilio (SMS service) - get from https://console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_FROM_NUMBER=+1234567890

# Google Calendar Integration
# Create a service account in Google Cloud Console
GOOGLE_CLIENT_EMAIL=calendar-service@your-project-id.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour private key here... \n-----END PRIVATE KEY-----\n"
GOOGLE_CALENDAR_ID=your-calendar-id@group.calendar.google.com

# ============================================
# 🔒 PUBLIC VARIABLES (safe to expose to client)
# ============================================

# Firebase Client SDK (from Firebase Console > Project Settings > General)
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:xxxxxxxxxxxxxxxx
