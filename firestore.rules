rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 🔒 JOBS COLLECTION - Public invoice viewing with restricted access
    match /jobs/{jobId} {
      
      // 🔒 READ RULES:
      // - GET (single document): Authenticated admins can read any job (they can already
      //   LIST all jobs, so this leaks nothing new — and lets them preview an invoice
      //   before it's sent). Unauthenticated public can only get payable/paid invoices so
      //   the public invoice page works. UNPAID is included because the reminder cron flips
      //   overdue INVOICED → UNPAID, and those customers must still be able to pay.
      // - LIST (query): Block for unauthenticated users (prevents data scraping/enumeration)
      allow get: if request.auth != null
                 || resource.data.status == 'INVOICED'
                 || resource.data.status == 'UNPAID'
                 || resource.data.status == 'PAID';
      allow list: if request.auth != null;
      
      // 🔒 WRITE: Strictly locked - all writes must go through Server Actions (firebase-admin)
      // Server Actions use the Admin SDK which bypasses these rules entirely
      allow write: if false; 
    }
    
    // 🔒 CLIENTS COLLECTION - Contains PII, strictly authenticated access only
    match /clients/{clientId} {
      // 🔒 READ: Requires authentication (prevents exposure of customer PII)
      // Admins access via Server Actions which bypass these rules
      allow read: if request.auth != null;
      
      // 🔒 WRITE: Locked - all writes through Server Actions only
      allow write: if false;
    }

    // 🔒 SERVICES COLLECTION - Admin-readable catalog, writes through Server Actions
    match /services/{serviceId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Public quote pricing contains no customer data. Only this one fixed
    // document is public-readable; list access and all client writes remain
    // denied. Admin updates use the server action through Firebase Admin.
    match /settings/quotePricing {
      allow get: if true;
      allow write: if false;
    }
  }
}
